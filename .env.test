# Configuración SOLO para pruebas e2e (npm run test:e2e). No contiene secretos reales:
# base local desechable, contraseña vacía (Postgres.app confía en localhost) y un
# JWT_SECRET ficticio. Nunca apuntes este archivo a la base de desarrollo o producción.
NODE_ENV=test
PORT=3099

DB_HOST=localhost
DB_PORT=5432
# Debe terminar en _test: test/utils/e2e-app.ts se niega a limpiar cualquier otra base.
DB_NAME=coursehub_test
DB_USER=postgres
DB_PASSWORD=

LOG_LEVEL=error
JWT_SECRET=e2e-only-fake-secret-not-used-anywhere-else-2026
JWT_EXPIRES_IN=5m
CORS_ORIGINS=http://localhost:5173
